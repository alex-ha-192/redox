use crate::tokens::Token;
use crate::lexer::LexicalError;
use crate::ast;

grammar;

extern {
  type Location = usize;
  type Error = LexicalError;
  enum Token {
    "Create" => Token::Create,
    "Set" => Token::Set,
    "Display" => Token::Display,
    "with" => Token::With,
    "value" => Token::Value,
    "takes" => Token::Takes,
    "returns" => Token::Returns,
    "Copyof" => Token::Copyof,
    "to" => Token::To,
    "Function" => Token::Function,
    "Return" => Token::Return,
    "Run" => Token::Run,
    "+" => Token::Add,
    "-" => Token::Subtract,
    "*" => Token::Multiply,
    "/" => Token::Divide,
    "%" => Token::Modulo,
    "=" => Token::Equals,
    "!=" => Token::NotEquals,
    "Append" => Token::Append,
    "Length" => Token::Length,
    "Integer" => Token::Integer,
    "Real" => Token::Real,
    "Character" => Token::Character,
    "Text" => Token::Text,
    "Boolean" => Token::Boolean,
    "List" => Token::List,
    "Nothing" => Token::Nothing,
    "(" => Token::LeftParen,
    ")" => Token::RightParen,
    "[" => Token::LeftSquareBrace,
    "]" => Token::RightSquareBrace,
    "{" => Token::LeftBrace,
    "}" => Token::RightBrace,
    "," => Token::Comma,
    "<" => Token::LeftAngle,
    ">" => Token::RightAngle,
    "<=" => Token::LessEqual,
    ">=" => Token::GreaterEqual,
    "If" => Token::If,
    "then" => Token::Then,
    "otherwise" => Token::Otherwise,
    "While" => Token::While,
    "is" => Token::Is,
    "Newline" => Token::Newline,
    "IntegerLiteral" => Token::IntegerLiteral(<i64>),
    "RealLiteral" => Token::RealLiteral(<f64>),
    "Identifier" => Token::Identifier(<String>),
    "TextLiteral" => Token::TextLiteral(<String>),
    "CharacterLiteral" => Token::CharacterLiteral(<char>),
    "BooleanLiteral" => Token::BooleanLiteral(<bool>),
  }
}

Comma<T>: Vec<T> = {
  <mut items:(<T> ",")*> <last:T?> => {
    match last {
      Some(t) => { items.push(t); items },
      None => items,
    }
  }
};

// ================================================================================================

Newlines: () = {
  <"Newline"*> => (),
};

// A statement is followed by at least one newline, which the lexer also
// supplies before a closing brace and at the end of the file.
NewlineRun: () = {
  <"Newline"+> => (),
};

pub Program: Vec<ast::Statement> = {
  <_newlines:Newlines> <statements:StatementSequence> => statements
};

StatementSequence: Vec<ast::Statement> = {
  => Vec::new(),
  <mut statements:StatementSequence> <statement:Statement> <_newlines:NewlineRun> => {
    statements.push(statement);
    statements
  },
};

Block: Vec<ast::Statement> = {
  "{" <_newlines:Newlines> <statements:StatementSequence> "}" => statements,
};

OtherwiseBlock: Vec<ast::Statement> = {
  "otherwise" <contents:Block> => contents,
};

pub Statement: ast::Statement = {
  "Create" <var_type:FullType> <name:"Identifier"> => {
    ast::Statement::Create {
      identifier: name,
      var_type,
      value: Box::new(None),
    }
  },
  "Create" <var_type:FullType> <name:"Identifier"> "with" "value" <value:Expression> => {
    ast::Statement::Create {
      identifier: name,
      var_type,
      value: Box::new(Some(*value)),
    }
  },
  "Set" <name:"Identifier"> "to" <value:Expression> => {
    ast::Statement::Set {
      identifier: name,
      value
    }
  },
  "Display" <value:Expression> => {
    ast::Statement::Display { value }
  },
  // `then` is mandatory; the `otherwise` branch is optional.
  "If" <cond:Expression> "then" <then:Block> <otherwise:OtherwiseBlock?> => {
    ast::Statement::If {
      condition: cond,
      then_contents: then,
      otherwise_contents: otherwise,
    }
  },
  // Only the literal `True` or `False` may follow `is`.
  "While" <cond:Expression> "is" <proceed:"BooleanLiteral"> <then:Block> => {
    ast::Statement::While {
      condition: cond,
      proceed,
      then_contents: then,
    }
  },
  "While" <cond:Expression> <then:Block> => {
    ast::Statement::While {
      condition: cond,
      proceed: true,
      then_contents: then,
    }
  },
  "Function" <name:"Identifier"> "takes" "(" <arguments:Comma<FunctionArgument>> ")" "returns" <return_type:FullType> <contents:Block> => {
    ast::Statement::Function {
      name,
      arguments,
      return_type: Box::new(return_type),
      contents,
    }
  },
  "Return" <expr:Expression> => {
    ast::Statement::Return {
      operand: expr,
    }
  },
  "Return" => {
    ast::Statement::Return {
      operand: Box::new(ast::Expression::NothingLiteral()),
    }
  },
  // `Run` runs a function call and discards its result.
  "Run" <function_identifier:"Identifier"> "(" <args:Comma<Expression>> ")" => {
    ast::Statement::Run {
      operand: Box::new(ast::Expression::FunctionCall {
        function_identifier,
        arguments: args.into_iter().map(|e| *e).collect(),
      }),
    }
  },
};

pub Expression: Box<ast::Expression> = {
  #[precedence(level="1")]
  Factor,
  #[precedence(level="3")] #[assoc(side="left")]
  <lhs:Expression> "*" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Mul,
      rhs
    })
  },
  <lhs:Expression> "/" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Div,
      rhs
    })
  },
  // In most languages, % has the same precedence as * and /
  <lhs:Expression> "%" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Modulo,
      rhs
    })
  },
  #[precedence(level="4")] #[assoc(side="left")]
  <lhs:Expression> "+" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Add,
      rhs
    })
  },
  <lhs:Expression> "-" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Sub,
      rhs
    })
  },
  // `Append` binds tighter than the comparison operators, so that
  // `a Equals b Append c` is `a Equals (b Append c)`.
  #[precedence(level="5")] #[assoc(side="left")]
  <lhs:Expression> "Append" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Append,
      rhs
    })
  },
  // Equality and relative operators
  #[precedence(level="6")] #[assoc(side="left")]
  <lhs:Expression> "=" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Equals,
      rhs
    })
  },
  <lhs:Expression> "!=" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::NotEquals,
      rhs
    })
  },
  <lhs:Expression> "<" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::LessThan,
      rhs
    })
  },
  <lhs:Expression> ">" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::GreaterThan,
      rhs
    })
  },
  <lhs:Expression> "<=" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::LessEqual,
      rhs
    })
  },
  <lhs:Expression> ">=" <rhs:Expression> => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::GreaterEqual,
      rhs
    })
  },
};

pub Factor: Box<ast::Expression> = {
  #[precedence(level="1")]
  Term,
  #[precedence(level="2")]
  "-" <operand:Factor> => {
    Box::new(ast::Expression::UnaryOperation {
      operator: ast::Operator::Sub,
      operand
    })
  },
  // A numeric literal may be written with a leading sign, e.g. `+1.5`.
  "+" <operand:Factor> => {
    Box::new(ast::Expression::UnaryOperation {
      operator: ast::Operator::Add,
      operand
    })
  },
};

pub Term: Box<ast::Expression> = {
  <val:"IntegerLiteral"> => {
    Box::new(ast::Expression::IntegerLiteral(val))
  },
  <val:"RealLiteral"> => {
    Box::new(ast::Expression::RealLiteral(val))
  },
  <val:"TextLiteral"> => {
    Box::new(ast::Expression::TextLiteral(val))
  },
  <val:"CharacterLiteral"> => {
    Box::new(ast::Expression::CharacterLiteral(val))
  },
  <name:"Identifier"> => {
    Box::new(ast::Expression::Identifier(name))
  },
  <val: "BooleanLiteral"> => {
    Box::new(ast::Expression::BooleanLiteral(val))
  },
  "Nothing" => {
    Box::new(ast::Expression::NothingLiteral())
  },
  <function_identifier:"Identifier"> "(" <args:Comma<Expression>> ")" => {
    Box::new(ast::Expression::FunctionCall {
      function_identifier,
      arguments: args.into_iter().map(|e| *e).collect(),
    })
  },
  ListLiteral,
  // `Length` is a built-in operation, not a function: `Length(a)`.
  "Length" "(" <operand:Expression> ")" => {
    Box::new(ast::Expression::UnaryOperation {
      operator: ast::Operator::Length,
      operand
    })
  },
  "(" <Expression> ")",
  // List/Text access is postfix, so it binds tighter than unary minus and the
  // arithmetic operators: `-a[0]` is `-(a[0])`, not `(-a)[0]`.
  <lhs:Term> "[" <rhs:Expression> "]" => {
    Box::new(ast::Expression::BinaryOperation {
      lhs,
      operator: ast::Operator::Access,
      rhs
    })
  },
};

ListLiteral: Box<ast::Expression> = {
  "[" <elements:Comma<Expression>> "]" => {
    Box::new(ast::Expression::ListLiteral {
        contents: elements.into_iter().map(|e| *e).collect(),
    })
  },
};

FunctionArgument: ast::FunctionArgument = {
  <copyof:"Copyof"?> <arg_type:FullType> <identifier:"Identifier"> => {
    ast::FunctionArgument {
      copyof: copyof.is_some(),
      arg_type: Box::new(arg_type),
      identifier,
    }
  }
};

pub FullType: ast::FullType = {
  <maintype:ScalarType> => {
    ast::FullType {
      main: maintype,
      subtype: None
    }
  },
  // A `List` always has an element type; there is no bare `List`.
  "List" "<" <subtype:FullType> ">" => {
    ast::FullType {
      main: ast::Type::List,
      subtype: Some(Box::new(subtype))
    }
  },
};

ScalarType: ast::Type = {
    "Integer" => ast::Type::Integer,
    "Real" => ast::Type::Real,
    "Character" => ast::Type::Character,
    "Text" => ast::Type::Text,
    "Boolean" => ast::Type::Boolean,
    "Nothing" => ast::Type::Nothing,
};
